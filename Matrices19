public class Ejercicio19 {
    public static void main(String[] args) {
        int n=5;
        int[][] M = new int[n][n];

        for(int i=0; i<n; i++){
            M[i][i] = 1;
        }

        for(int[] fila : M){
            for(int val : fila) System.out.print(val + " ");
            System.out.println();
        }
    }
}
