import java.util.*;

public class Ejercicio9 {
    public static void main(String[] args) {
        int[] A = {-3,0,5,-1,7,0,2};
        int neg=0,pos=0,ceros=0;

        for(int num : A){
            if(num < 0) neg++;
            else if(num > 0) pos++;
            else ceros++;
        }

        System.out.println("Negativos: " + neg);
        System.out.println("Positivos: " + pos);
        System.out.println("Ceros: " + ceros);
    }
}
